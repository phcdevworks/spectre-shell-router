{
  "name": "@phcdevworks/spectre-shell-router",
  "version": "1.4.1",
  "description": "@phcdevworks/spectre-shell-router is the client-side router package of the Spectre system. It maps URL paths to lazy page modules, renders into a root element, and keeps navigation behavior framework-agnostic for Spectre-based applications.",
  "keywords": [
    "phcdevworks",
    "spectre",
    "spectre-shell-router",
    "router",
    "client-side-routing",
    "url-routing",
    "framework-agnostic",
    "typescript",
    "history-api",
    "browser"
  ],
  "author": "PHCDevworks",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.check.json",
    "test": "vitest",
    "release:propose": "node --import jiti/register scripts/propose-version.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:md": "prettier --write \"**/*.md\"",
    "check:ecosystem": "spectre-manifest-validate spectre.manifest.json && spectre-manifest-check spectre.manifest.json .",
    "check:version-sync": "node --experimental-strip-types scripts/check-readme-version.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm test -- --run && npm run check:version-sync && npm run check:ecosystem",
    "prepublishOnly": "npm run check"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/phcdevworks"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phcdevworks/spectre-shell-router.git"
  },
  "bugs": {
    "url": "https://github.com/phcdevworks/spectre-shell-router/issues"
  },
  "homepage": "https://github.com/phcdevworks/spectre-shell-router#readme",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "typescript": "^5.0 || ^6.0 || ^7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phcdevworks/spectre-manifest": "^1.1.0",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
