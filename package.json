{
  "name": "@phcdevworks/spectre-shell-router",
  "version": "1.2.0",
  "description": "Minimal, framework-agnostic client-side router for Spectre-based applications.",
  "keywords": [
    "phcdevworks",
    "spectre",
    "spectre-shell-router",
    "router",
    "client-side-routing",
    "url-routing",
    "framework-agnostic",
    "typescript",
    "history-api",
    "browser"
  ],
  "author": "PHCDevworks",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "release:propose": "node --import jiti/register scripts/propose-version.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:md": "prettier --write \"**/*.md\"",
    "check:ecosystem": "spectre-manifest-validate spectre.manifest.json && spectre-manifest-check spectre.manifest.json .",
    "check:version-sync": "node --experimental-strip-types scripts/check-readme-version.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm test -- --run && npm run check:version-sync && npm run check:ecosystem",
    "prepublishOnly": "npm run check"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/phcdevworks"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phcdevworks/spectre-shell-router.git"
  },
  "bugs": {
    "url": "https://github.com/phcdevworks/spectre-shell-router/issues"
  },
  "homepage": "https://github.com/phcdevworks/spectre-shell-router#readme",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@phcdevworks/spectre-manifest": "^1.0.0",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
